# Debug Dockerfile with AddressSanitizer for finding memory corruption bugs
# Usage: podman build -f Dockerfile.debug --no-cache -t tsdb-asan .
#        podman run --rm -e POSTGRES_PASSWORD=postgres -p 5445:5432 tsdb-asan

ARG PG_VERSION=17-bookworm

FROM docker.io/library/postgres:${PG_VERSION} AS builder

RUN apt update && apt install -y --no-install-recommends \
    build-essential cmake git ca-certificates \
    postgresql-server-dev-17 \
    libicu-dev \
    libkrb5-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /src
WORKDIR /src

# Build with AddressSanitizer — detects heap overflows, use-after-free, etc.
# Set ASAN flags via environment so CMake's compiler check passes,
# then the actual compilation uses them.
ENV CC="gcc"
ENV CFLAGS="-fsanitize=address -fno-omit-frame-pointer -O1 -g"
ENV LDFLAGS="-fsanitize=address"
RUN ./bootstrap \
      -DCMAKE_BUILD_TYPE=Debug \
      -DASSERTIONS=ON \
      -DREGRESS_CHECKS=OFF \
      -DAPACHE_ONLY=OFF \
    && cd build \
    && make -j"$(nproc)" \
    && make DESTDIR=/install install

ARG PG_VERSION
FROM docker.io/library/postgres:${PG_VERSION}

# Need libasan at runtime
RUN apt update && apt install -y --no-install-recommends \
    libasan8 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install/usr/lib/postgresql/ /usr/lib/postgresql/
COPY --from=builder /install/usr/share/postgresql/ /usr/share/postgresql/

RUN echo "shared_preload_libraries = 'timescaledb'" >> /usr/share/postgresql/postgresql.conf.sample

RUN echo "CREATE EXTENSION IF NOT EXISTS timescaledb;" \
    > /docker-entrypoint-initdb.d/001-timescaledb.sql

# ASAN needs these env vars to produce useful output
ENV ASAN_OPTIONS=detect_leaks=0:halt_on_error=0:log_path=/tmp/asan:print_stacktrace=1:abort_on_error=0
# Preload shared ASAN runtime so postgres can load our sanitized .so
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libasan.so.8

EXPOSE 5432
